{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Gateway": "Data Source=gateway.db" },
  "Gateway": {
    "MaxAttempts": 5,
    "BaseDelaySeconds": 2,
    "MaxDelaySeconds": 300,
    "PollIntervalSeconds": 2,
    "SourceSecrets": { },
    "Connectors": {
      "accounting": { "Kind": "mock", "FailFirstAttempts": 1 },
      "crm": { "Kind": "mock" },
      "legacy-erp": { "Kind": "mock", "AlwaysFail": true }
    },
    "Routes": [
      {
        "Name": "shop-orders-to-accounting",
        "Source": "shop",
        "Type": "order.created",
        "Connector": "accounting",
        "Map": { "reference": "$.orderId", "contactName": "$.customer.name", "contactEmail": "$.customer.email", "total": "$.total", "currency": "$.currency" }
      },
      {
        "Name": "shop-customers-to-crm",
        "Source": "shop",
        "Type": "*",
        "Connector": "crm",
        "Map": { "email": "$.customer.email", "name": "$.customer.name", "lastEvent": "$.event" }
      },
      {
        "Name": "shop-orders-to-legacy-erp",
        "Source": "shop",
        "Type": "order.created",
        "Connector": "legacy-erp",
        "Map": { }
      }
    ]
  }
}
